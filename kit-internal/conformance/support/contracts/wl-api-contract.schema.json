{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.example/schemas/wl-api-contract-v1.json",
  "title": "WL API Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "protocolVersion",
    "source",
    "resource",
    "transport",
    "operations",
    "models",
    "frontend",
    "completion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "wl-api-contract"
    },
    "protocolVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "contractHash": {
          "$ref": "#/$defs/hash"
        },
        "apiHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "module",
        "entity",
        "description",
        "permissionPrefix"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "permissionPrefix": {
          "type": "string",
          "minLength": 1
        },
        "externalId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successCode",
        "envelope",
        "pagination",
        "controllerBasePath",
        "externalBasePath"
      ],
      "properties": {
        "successCode": {
          "type": "integer"
        },
        "envelope": {
          "const": [
            "code",
            "message",
            "data"
          ]
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestCurrent",
            "requestSize",
            "defaultCurrent",
            "defaultSize",
            "maxSize",
            "recordsPath",
            "totalPath"
          ],
          "properties": {
            "requestCurrent": {
              "type": "string",
              "minLength": 1
            },
            "requestSize": {
              "type": "string",
              "minLength": 1
            },
            "defaultCurrent": {
              "type": "integer",
              "minimum": 1
            },
            "defaultSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxSize": {
              "type": "integer",
              "minimum": 1
            },
            "recordsPath": {
              "type": "string",
              "minLength": 1
            },
            "totalPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "controllerBasePath": {
          "$ref": "#/$defs/path"
        },
        "externalBasePath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "operations": {
      "type": "object",
      "required": [
        "page",
        "detail",
        "create",
        "update",
        "remove"
      ],
      "properties": {
        "page": {
          "$ref": "#/$defs/operation"
        },
        "detail": {
          "$ref": "#/$defs/operation"
        },
        "create": {
          "$ref": "#/$defs/operation"
        },
        "update": {
          "$ref": "#/$defs/operation"
        },
        "remove": {
          "$ref": "#/$defs/operation"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    },
    "extensionOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "validationRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationRule"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "models": {
      "type": "object",
      "required": [
        "pageRequest",
        "createRequest",
        "updateRequest",
        "detailResponse",
        "pageResponse"
      ],
      "properties": {
        "pageRequest": {
          "$ref": "#/$defs/model"
        },
        "createRequest": {
          "$ref": "#/$defs/model"
        },
        "updateRequest": {
          "$ref": "#/$defs/model"
        },
        "detailResponse": {
          "$ref": "#/$defs/model"
        },
        "pageResponse": {
          "$ref": "#/$defs/model"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiConfig",
        "pathParameterSyntax",
        "notes"
      ],
      "properties": {
        "apiConfig": {
          "type": "object",
          "required": [
            "list",
            "getById",
            "save",
            "update",
            "remove"
          ],
          "properties": {
            "list": {
              "$ref": "#/$defs/path"
            },
            "getById": {
              "$ref": "#/$defs/path"
            },
            "save": {
              "$ref": "#/$defs/path"
            },
            "update": {
              "$ref": "#/$defs/path"
            },
            "remove": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "pathParameterSyntax": {
          "const": "RFC6570-simple"
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractStatus",
        "openQuestions",
        "deviations",
        "skeletonOperations"
      ],
      "properties": {
        "contractStatus": {
          "enum": [
            "draft",
            "confirmed"
          ]
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "skeletonOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "assuranceMissing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Missing producer assurance facts or evidence references, for example threatModelRef:docs/evidence/threat-model.md."
        }
      }
    },
    "assurance": {
      "$ref": "#/$defs/assurance"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "controllerPath",
        "externalPath",
        "permission",
        "requestModel",
        "responseModel"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "PATCH"
          ]
        },
        "controllerPath": {
          "$ref": "#/$defs/path"
        },
        "externalPath": {
          "$ref": "#/$defs/path"
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "requestModel": {
          "type": "string",
          "minLength": 1
        },
        "responseModel": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "idFrom": {
          "enum": [
            "path",
            "body",
            "none"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "startField",
        "endField",
        "operations",
        "message",
        "source",
        "allowEqual"
      ],
      "properties": {
        "kind": {
          "const": "chronology"
        },
        "startField": {
          "type": "string",
          "minLength": 1
        },
        "endField": {
          "type": "string",
          "minLength": 1
        },
        "allowEqual": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create",
              "update",
              "page"
            ]
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "httpStatus",
        "message",
        "owner",
        "retryable",
        "operations"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "required",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "format": {
          "type": "string"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "description": "兼容旧版契约；新契约统一写入 constraints.maxLength"
        },
        "default": {},
        "constraints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "minLength": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "minExclusive": {
              "type": "boolean"
            },
            "maxExclusive": {
              "type": "boolean"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "totalDigits": {
              "type": "integer",
              "minimum": 1
            },
            "fractionDigits": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "constraintSource": {
          "type": "string",
          "minLength": 1
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "x-semantic-id": {
          "type": "string",
          "minLength": 1
        },
        "x-data-classification": {
          "type": "string",
          "minLength": 1
        },
        "x-masking": {
          "type": "string",
          "minLength": 1
        },
        "x-id-format": {
          "enum": [
            "opaque",
            "uuid",
            "numeric-string"
          ]
        },
        "items": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "description": "Optional production-assurance facts emitted by the producer. Delivery profiles and producer validation apply their own operating budgets and security policy.",
      "properties": {
        "level": {
          "enum": [
            "standard",
            "production"
          ]
        },
        "criticality": {
          "enum": [
            "core",
            "important",
            "standard"
          ]
        },
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availabilityPercent",
            "p95LatencyMs",
            "p99LatencyMs",
            "maxErrorRatePercent"
          ],
          "properties": {
            "availabilityPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "p95LatencyMs": {
              "type": "integer",
              "minimum": 0
            },
            "p99LatencyMs": {
              "type": "integer",
              "minimum": 0
            },
            "maxErrorRatePercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rtoMinutes",
            "rpoMinutes"
          ],
          "properties": {
            "rtoMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "rpoMinutes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorizationModel",
            "methodSecurityRequired",
            "auditRequired"
          ],
          "properties": {
            "authorizationModel": {
              "type": "string",
              "minLength": 1
            },
            "methodSecurityRequired": {
              "type": "boolean"
            },
            "auditRequired": {
              "type": "boolean"
            }
          }
        },
        "dataGovernance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "sourceOfTruth",
            "classificationDefault",
            "retentionPolicy"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "sourceOfTruth": {
              "type": "string",
              "minLength": 1
            },
            "classificationDefault": {
              "enum": [
                "public",
                "internal",
                "confidential",
                "restricted"
              ]
            },
            "retentionPolicy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "consistency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotencyStrategy",
            "eventDelivery",
            "crossServiceTransaction"
          ],
          "properties": {
            "idempotencyStrategy": {
              "type": "string",
              "minLength": 1
            },
            "eventDelivery": {
              "type": "string",
              "minLength": 1
            },
            "crossServiceTransaction": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dependencyTimeoutMs",
            "retryMaxAttempts",
            "circuitBreakerRequired",
            "rateLimitRequired"
          ],
          "properties": {
            "dependencyTimeoutMs": {
              "type": "integer",
              "minimum": 0
            },
            "retryMaxAttempts": {
              "type": "integer",
              "minimum": 0
            },
            "circuitBreakerRequired": {
              "type": "boolean"
            },
            "rateLimitRequired": {
              "type": "boolean"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threatModelRef",
            "authorizationReviewRef",
            "loadTestRef",
            "runbookRef",
            "restoreDrillRef",
            "dataReviewRef"
          ],
          "properties": {
            "threatModelRef": {
              "type": "string",
              "minLength": 1
            },
            "authorizationReviewRef": {
              "type": "string",
              "minLength": 1
            },
            "loadTestRef": {
              "type": "string",
              "minLength": 1
            },
            "runbookRef": {
              "type": "string",
              "minLength": 1
            },
            "restoreDrillRef": {
              "type": "string",
              "minLength": 1
            },
            "dataReviewRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "if": {
        "properties": {
          "level": {
            "const": "production"
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "required": [
          "criticality",
          "slo",
          "recovery",
          "security",
          "dataGovernance",
          "consistency",
          "resilience",
          "evidence"
        ],
        "properties": {
          "criticality": {},
          "slo": {},
          "recovery": {},
          "security": {},
          "dataGovernance": {},
          "consistency": {},
          "resilience": {},
          "evidence": {}
        }
      }
    },
    "relationQueryOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "controllerPath",
        "externalPath",
        "responseModel"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "PATCH"
          ]
        },
        "controllerPath": {
          "$ref": "#/$defs/path"
        },
        "externalPath": {
          "$ref": "#/$defs/path"
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "requestModel": {
          "type": "string",
          "minLength": 1
        },
        "responseModel": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "idFrom": {
          "enum": [
            "path",
            "body",
            "none"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "detailEntity",
        "detailContractId",
        "joinColumn"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "detailEntity": {
          "type": "string",
          "minLength": 1
        },
        "detailContractId": {
          "type": "string",
          "minLength": 1
        },
        "joinColumn": {
          "type": "string",
          "minLength": 1
        },
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "cascadeSoftDelete": {
          "type": "boolean"
        },
        "exposeQuery": {
          "type": "boolean"
        },
        "queryOperation": {
          "$ref": "#/$defs/relationQueryOperation"
        }
      }
    }
  },
  "description": "Shared structural interchange for independently produced API facts. Producer-specific budgets and delivery-profile semantics remain validated by each package."
}
