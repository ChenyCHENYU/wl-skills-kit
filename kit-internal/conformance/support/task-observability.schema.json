{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wl-skills:task-observability:1",
  "title": "WL independent package task and execution evidence v1",
  "type": "object",
  "required": [
    "recordVersion",
    "kind",
    "packageName",
    "packageVersion",
    "runId",
    "recordedAt",
    "eventId",
    "targets",
    "inputSnapshot",
    "executionStatus",
    "validationStatus"
  ],
  "properties": {
    "recordVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "task-decision",
        "tool-started",
        "tool-finished"
      ]
    },
    "packageName": {
      "type": "string",
      "pattern": "^@agile-team/wl-skills-(kit|ui|bd|design|test)$"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "task": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "invocation": {
      "type": "object",
      "required": ["channel", "tool"],
      "properties": {
        "channel": { "const": "mcp" },
        "tool": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "executionStatus": {
      "enum": [
        "not-executed",
        "started",
        "completed",
        "failed"
      ]
    },
    "validationStatus": {
      "enum": [
        "passed",
        "failed",
        "partial",
        "unverified",
        "not-applicable"
      ]
    },
    "exitCode": {
      "type": "integer"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "inputSnapshot": {
      "$ref": "#/definitions/snapshot"
    },
    "inputBefore": {
      "$ref": "#/definitions/snapshot"
    },
    "ruleSnapshot": {
      "$ref": "#/definitions/snapshot"
    },
    "configSnapshot": {
      "$ref": "#/definitions/snapshot"
    },
    "checkedSnapshot": {
      "$ref": "#/definitions/snapshot"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "executionStartedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "decision": {
      "$ref": "#/definitions/decision"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "checkedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file"
      }
    },
    "checkedScopeSource": {
      "enum": [
        "executor",
        "unreported"
      ]
    },
    "summary": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file"
      }
    },
    "changedDuringCheck": {
      "type": "boolean"
    },
    "errorCode": {
      "type": "string"
    },
    "recordPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "notice": {
      "$ref": "#/definitions/notice"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task-decision"
          }
        }
      },
      "then": {
        "required": [
          "task",
          "decision"
        ],
        "properties": {
          "executionStatus": {
            "const": "not-executed"
          },
          "validationStatus": {
            "const": "unverified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool-started"
          }
        }
      },
      "then": {
        "required": [
          "tool"
        ],
        "properties": {
          "executionStatus": {
            "const": "started"
          },
          "validationStatus": {
            "const": "unverified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool-finished"
          }
        }
      },
      "then": {
        "required": [
          "tool",
          "executionId",
          "executionStartedAt",
          "exitCode",
          "durationMs",
          "checks",
          "artifacts",
          "inputBefore",
          "changedDuringCheck"
        ],
        "properties": {
          "executionStatus": {
            "enum": [
              "completed",
              "failed"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "notice": {
      "type": "object",
      "required": [
        "schemaVersion",
        "packageName",
        "packageVersion",
        "runId",
        "decision",
        "skills",
        "rules",
        "requiredChecks",
        "executionStatus",
        "validationStatus",
        "displayEvidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packageName": {
          "type": [
            "string",
            "null"
          ]
        },
        "packageVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "executionStatus": {
          "type": "string"
        },
        "validationStatus": {
          "type": "string"
        },
        "displayEvidence": {
          "const": "unverified"
        },
        "summary": {
          "type": "string"
        },
        "usageChain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "status"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "routing",
                  "host-discovery",
                  "content-loading",
                  "tool-execution",
                  "validation"
                ]
              },
              "status": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mcpTools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "pendingChecks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nextActions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "commandHint": {
                "type": "string"
              },
              "cwd": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "skillDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "validationIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "check": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "targets",
        "files",
        "omitted",
        "complete",
        "sha256"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/file"
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resolution": {
          "enum": [
            "project-internal-realpath",
            "authorized-read-realpath"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "selectedSkills",
        "requiredChecks",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "baseline",
            "ambiguous",
            "gap",
            "not-applicable",
            "needs-context"
          ]
        },
        "selectedSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "scope": {
          "$ref": "#/definitions/scope"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status",
        "reason",
        "evidencePaths"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not-applicable",
            "unverified",
            "not-executed"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidencePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "reason",
        "adopted",
        "inherited"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "status": {
          "enum": [
            "applicable",
            "not-applicable",
            "needs-context"
          ]
        },
        "adopted": {
          "type": "boolean"
        },
        "inherited": {
          "const": false
        },
        "reason": {
          "type": "string"
        },
        "projectType": {
          "type": "string"
        },
        "projectRoot": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
