{
  "boundaryVersion": 1,
  "package": "@agile-team/wl-skills-kit",
  "capabilities": [
    {
      "id": "frontend.delivery",
      "intents": [
        "create",
        "validate",
        "repair",
        "maintain"
      ],
      "inputs": [
        "reviewed-requirements",
        "page-spec",
        "wl-api-contract"
      ],
      "outputs": [
        "vue-pages",
        "page-spec",
        "wl-api-contract"
      ]
    },
    {
      "id": "frontend.task-observability",
      "intents": [
        "route",
        "explain",
        "record-execution",
        "status",
        "diagnose-host"
      ],
      "inputs": [
        "task-description",
        "target-paths",
        "actual-tool-results"
      ],
      "outputs": [
        "task-decision",
        "execution-receipts",
        "gap-proposals",
        "host-entry-diagnostics"
      ]
    }
  ],
  "standalone": {
    "requiresSiblingPackages": [],
    "missingBusinessFacts": "report-unresolved",
    "projectInputsOwnedBy": "project",
    "generatedPageRequirements": {
      "framework": "Vue 3",
      "host": "project composables, API adapters and component library",
      "uiRuntime": "required by compiler outputs that import @agile-team/wl-skills-ui/runtime; CLI and contract operations remain independent"
    }
  },
  "composition": {
    "contributionId": "wl-skills-kit",
    "protocolVersion": "1.0",
    "optionalTraceInput": "design-model",
    "unknownProtocol": "reject-or-explicit-migration",
    "apiAuthority": "validated-effective-api-manifest",
    "sharedWrites": "own-block-or-json-entry-only",
    "observability": {
      "recordVersion": 1,
      "schema": "lib/task-observability.schema.json",
      "storage": ".wl-skills/runs",
      "runCorrelation": "explicit-runId-or-WL_TASK_RUN_ID",
      "eventPublication": "immutable-per-package-events",
      "hostDiscovery": "unverified-without-host-events",
      "gapPolicy": "propose-review-before-changing-business-rules"
    }
  }
}
